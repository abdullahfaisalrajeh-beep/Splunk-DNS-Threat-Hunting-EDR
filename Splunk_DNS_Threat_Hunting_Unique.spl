index="vpn3" source="*DNS-Client/Operational" EventCode=3008
| rex field=_raw "the name (?<DomainName>[^,]+)"
| where isnotnull(DomainName)
| eval DomainName=lower(DomainName)
| search NOT DomainName IN ("wpad", "*.microsoft.com", "*.msn.com", "*.t-msedge.net", "*.windowsupdate.com", "*.windows.com", "*.live.com", "*.msftncsi.com", "*.sfx.ms", "*.delivery.mp.microsoft.com", "dns.msftncsi.com")
| dedup host, DomainName
| table _time, host, DomainName
| sort - _time











